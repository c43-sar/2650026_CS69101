  {
   "cell_type": "code",
   "execution_count": 58,
   "id": "69699631",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1164x1164 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
