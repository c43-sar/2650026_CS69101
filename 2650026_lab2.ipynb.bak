  {
   "cell_type": "markdown",
   "id": "df89baaa",
   "metadata": {},
   "source": [
    "## Reverse Sorted"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 70,
   "id": "7f89c656",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sort the random data for each size in reverse order\n",
    "for i in random_data_dict.keys():\n",
    "    random_data_dict[i] = sorted(random_data_dict[i], reverse=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 71,
   "id": "2c98e47a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Random insertions:\n",
    "build_times_dict = {}  # To store build times for each size\n",
    "height_dict = {}  # To store heights for each size\n",
    "bst_trees_dict = {}  # To store the root nodes of BSTs for each size\n",
    "for i in random_data_dict.keys():\n",
    "    root_node_temp = None\n",
    "    build_times = []\n",
    "    heights = []\n",
    "    for value in random_data_dict[i]:\n",
    "        iterations = 0 # Reset iteration count before insertions\n",
    "        root_node_temp = BST_Insert(value, root_node_temp)\n",
    "        build_times.append(iterations)  # Store iteration count for each insertion\n",
    "        heights.append(BST_Height(root_node_temp))  # Store height after each insertion\n",
    "    bst_trees_dict[i] = root_node_temp  # Store the root node of the BST of size 'i'\n",
    "    build_times_dict[i] = build_times  # Store iteration counts for building the BST of size 'i'\n",
    "    height_dict[i] = heights  # Store heights for the BST of size 'i'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 72,
   "id": "cf1bfc29",
   "metadata": {},
   "outputs": [],
   "source": [
    "rev_sorted_insertions_df = pd.DataFrame({\n",
    "    'Input Size (Reverse Sorted)': [1000, 5000, 10000],\n",
    "    'Avg Build Time (Iterations)': [sum(build_times_dict[i])/len(build_times_dict[i]) for i in build_times_dict.keys()],\n",
    "    'Max Build Time (Iterations)': [max(build_times_dict[i]) for i in build_times_dict.keys()],\n",
    "    'Min Build Time (Iterations)': [min(build_times_dict[i]) for i in build_times_dict.keys()],\n",
    "    'Max Height': [max(height_dict[i]) for i in height_dict.keys()],\n",
    "    'Min Height': [min(height_dict[i]) for i in height_dict.keys()],\n",
